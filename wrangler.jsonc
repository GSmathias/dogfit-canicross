{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dogfit-canicross",
  "account_id": "a8cf2bac201ecee5dbc088fc67b8e045",
  "main": "./worker.js",
  "compatibility_date": "2026-08-22",

  "observability": {
    "enabled": true
  },

  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/pagamento/*",
      "/media/*",
      "/admin",
      "/admin.html",
      "/club-admin",
      "/club-admin.html",
      "/inscricoes-admin",
      "/inscricoes-admin.html",
      "/cliente",
      "/cliente.html",
      "/minha-conta",
      "/minha-conta.html",
      "/parceiro",
      "/parceiro.html",
      "/clube/*"
    ]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dogfit-db",
      "database_id": "f8b62441-627a-4f85-8fcc-dfc357ffe111"
    }
  ],

  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "dogfit-media"
    }
  ]
}
