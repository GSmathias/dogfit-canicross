{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dogfit-canicross",
  "main": "./worker.js",
  "compatibility_date": "2026-08-22",

  "observability": {
    "enabled": true
  },

  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/media/*",
      "/admin",
      "/admin.html"
    ]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dogfit-db",
      "database_id": "f8b62441-627a-4f85-8fcc-dfc357ffe111"
    }
  ],

  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "dogfit-media"
    }
  ]
}